# Copy to .env, replace every blank secret, and keep .env out of version control.
RSYNC_USER=
RSYNC_PASSWORD=
INTERNAL_API_TOKEN=
ADMIN_USER=
ADMIN_PASS=
SCHNORARR_IMAGE_DIGEST=

# The certificate must cover sender/receiver service names and any browser hostname.
TLS_CERT_PATH=./certs/tls.crt
TLS_KEY_PATH=./certs/tls.key
TLS_CA_PATH=./certs/ca.crt

DASHBOARD_BIND_ADDRESS=127.0.0.1
RSYNC_BIND_ADDRESS=127.0.0.1
RECEIVER_API_BIND_ADDRESS=127.0.0.1
SENDER_DATA_PATH=./sender
RECEIVER_DATA_PATH=./receiver
